# Local default. Never commit .env or put secrets in VITE_* variables.
APP_ORIGIN=http://127.0.0.1:4504
PORT=4504
# Production: NODE_ENV=production, APP_ORIGIN=https://stemify.ca
# Required in production: use a managed PostgreSQL database and authenticated mail service.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# SMTP_URL=smtps://USER:URL_ENCODED_PASSWORD@SMTP_HOST:465
# MAIL_FROM=STEMIFY <accounts@YOUR_VERIFIED_DOMAIN>
# Set only when deployed behind Render's known proxy.
# TRUST_PROXY_HOPS=1
# Optional until Zoom is configured. Both are needed to enable the webhook.
# ZOOM_ACCOUNT_ID=
# ZOOM_WEBHOOK_SECRET=
